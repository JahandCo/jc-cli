# CI-only image for the `release-cli` workflow -- not a deployable app
# image. Requires .dockerignore (this Dockerfile's own override of a
# default gitignore-style exclusion) so goreleaser's own git-log
# changelog walk and tag detection see real history baked in at build
# time.
FROM golang:1.26-alpine AS build
RUN apk add --no-cache git
RUN go install github.com/goreleaser/goreleaser/v2@latest
WORKDIR /repo
COPY . .
ENTRYPOINT ["goreleaser"]
