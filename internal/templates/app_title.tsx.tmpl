"use client";

import * as React from "react";
import {
  initJahAndCo,
  LobbyProvider,
  useLobby,
  Frame,
  UserGrid,
  ChatBox,
  ReadyToggle,
  Host,
  Panel,
  Stack,
  tokens,
} from "@jahandco/interactive-sdk";
import { PhaserGame } from "./PhaserGame";

const GAME_ID = "{{.Slug}}";
const DISPLAY_NAME = "{{.DisplayName}}";

// Call once per page load, before anything below reads jc.* -- the same
// rule any other jc.* usage follows (initJahAndCo's own doc comment).
initJahAndCo({ gameId: GAME_ID, sessionToken: "dev-session" });

// Named consts, not inline JSX style objects -- Go's text/template (see
// internal/templates/templates.go's RenderTemplate) uses double curly
// braces for its own actions, so an inline style object's own doubled
// curly braces are indistinguishable from a template action to the parser
// rendering this .tmpl file into real source. Keep any new style prop as
// a named const instead.
const containerStyle: React.CSSProperties = {
  minHeight: "100vh",
  background: tokens.color.background,
  color: tokens.color.text,
  fontFamily: tokens.font.mono,
  padding: "1.5rem",
};
const stackStyle: React.CSSProperties = { maxWidth: 720, margin: "0 auto" };
const titleStyle: React.CSSProperties = { fontFamily: tokens.font.display, letterSpacing: 0.5, margin: 0 };
const lobbyContainerStyle: React.CSSProperties = { height: 420 };
const connectingStyle: React.CSSProperties = { color: tokens.color.textMuted };
const errorStyle: React.CSSProperties = { color: tokens.color.danger };
const lobbyStackStyle: React.CSSProperties = { height: "100%" };
const membersRowStyle: React.CSSProperties = { flex: 1, minHeight: 0 };
const memberGridColStyle: React.CSSProperties = { flex: 2, minWidth: 0 };
const chatColStyle: React.CSSProperties = { flex: 1, minWidth: 240 };

function noop(): void {}

// Custom layout (Frame/UserGrid/ChatBox/ReadyToggle/Host) rather than the
// turnkey <LobbyWrapper/> -- LobbyWrapper doesn't expose lobby.status to
// its parent, and this component needs to know the moment the host hits
// Start Game so it can hand off to <PhaserGame/>. Deliberately doesn't
// signal engineReady here -- that's BaseGameScene's job (see
// scenes/Game.ts), once the real game client has actually mounted;
// signaling it from the lobby, before Phaser exists, would be premature.
function LobbyScreen({ onGameStart }: { onGameStart: (playerId: string) => void }): React.JSX.Element {
  const { lobby, status, error, currentUserId } = useLobby();
  const handedOff = React.useRef(false);

  React.useEffect(() => {
    if (lobby?.status === "in_progress" && currentUserId && !handedOff.current) {
      handedOff.current = true;
      onGameStart(currentUserId);
    }
  }, [lobby?.status, currentUserId, onGameStart]);

  if (status === "connecting") {
    return <Panel style={connectingStyle}>Connecting to lobby...</Panel>;
  }
  if (status === "error") {
    return <Panel style={errorStyle}>Couldn't connect to lobby{error ? `: ${error}` : "."}</Panel>;
  }

  return (
    <Stack gap="0.75rem" style={lobbyStackStyle}>
      <Frame>
        {lobby ? (
          <span>
            {DISPLAY_NAME} — {lobby.members.length}/{lobby.capacity} players
          </span>
        ) : null}
      </Frame>
      <Stack direction="row" gap="0.75rem" style={membersRowStyle}>
        <div style={memberGridColStyle}>
          <UserGrid />
        </div>
        <div style={chatColStyle}>
          <ChatBox />
        </div>
      </Stack>
      <Stack direction="row" gap="0.75rem">
        <ReadyToggle />
        <Host onClose={noop} />
      </Stack>
    </Stack>
  );
}

// The Lobby Structure (pre-game) and Phaser (gameplay) composed in one
// real React tree -- see PhaserGame.tsx's own doc comment for why this
// needs Next.js rather than the bare esbuild/vanilla-DOM setup jc init
// used to scaffold client.ts/client_ui_example.tsx from.
export function Title(): React.JSX.Element {
  const [playerId, setPlayerId] = React.useState<string | null>(null);

  if (playerId) {
    return <PhaserGame gameId={GAME_ID} playerId={playerId} />;
  }

  return (
    <div style={containerStyle}>
      <Stack gap="1rem" style={stackStyle}>
        <h1 style={titleStyle}>{DISPLAY_NAME}</h1>
        <div style={lobbyContainerStyle}>
          <LobbyProvider mode="create" capacity={4}>
            <LobbyScreen onGameStart={setPlayerId} />
          </LobbyProvider>
        </div>
      </Stack>
    </div>
  );
}
