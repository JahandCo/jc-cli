import Phaser from "phaser";
import { JcBridgePlugin, type BridgeClientOptions } from "@jahandco/interactive-sdk/phaser-plugin";
import { BootScene } from "./scenes/Boot.js";
import { PreloaderScene } from "./scenes/Preloader.js";
import { MainMenuScene } from "./scenes/MainMenu.js";
import { GameScene } from "./scenes/Game.js";
import { GameOverScene } from "./scenes/GameOver.js";

// Your title's client-side rendering, via Phaser (mandatory -- see
// PHASER_INTEGRATION.md in the platform repo if you're curious why). Every
// scene gets `this.jc` for free via the plugin registered below -- never
// construct your own BridgeClient or touch window.postMessage directly.
// Scene setup itself lives in ./scenes/ -- this file is just Phaser.Game
// construction and the scene pipeline (Boot -> Preloader -> MainMenu ->
// Game -> GameOver).
new Phaser.Game({
  type: Phaser.AUTO,
  parent: "game",
  width: 800,
  height: 600,
  backgroundColor: "#0b0f19",
  plugins: {
    global: [
      {
        key: "JcBridgePlugin",
        plugin: JcBridgePlugin,
        start: true,
        mapping: "jc",
        data: { gameId: "{{.Slug}}", sessionToken: "dev-session" } satisfies BridgeClientOptions,
      },
    ],
  },
  scene: [BootScene, PreloaderScene, MainMenuScene, GameScene, GameOverScene],
});
