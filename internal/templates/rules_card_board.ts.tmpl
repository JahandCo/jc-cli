// Reference example, not a live `jc init title` scaffold -- since the
// 2026-07-22 taxonomy pivot (TAXONOMY.md), `GetRulesTemplate` always emits
// rules_default.ts.tmpl regardless of --theme; this file is kept as a full
// worked example of TurnOrder + stateViewsForPlayers, linked from
// packages/mechanics/README.md. Copy what's useful into your own rules.ts.

import type { BridgeEnvelope, multiplayer, WorkerContext } from "@jahandco/interactive-protocol";
import { TurnOrder, createSessionStore, reply, stateViewsForPlayers } from "@jahandco/interactive-mechanics";

// Card/Board: turn-based is the defining trait. Duration, events,
// conditions, and rulesets/logic are yours to define below. This starter
// enforces turn order and nothing else -- add your ruleset's actual logic
// (win conditions, card effects, board state) in place of "table".

interface TableSession {
  turns: TurnOrder;
  table: unknown[];
}

// Used only when no real match roster is available (context.roster, see
// below) -- jc dev's local sandbox in particular doesn't have
// dispatch/roster wiring yet, so this keeps that loop working.
const DEFAULT_PLAYERS = ["p1", "p2"];

const sessions = createSessionStore<TableSession>(() => ({
  turns: new TurnOrder(DEFAULT_PLAYERS),
  table: [],
}));

export function handleIntent(envelope: BridgeEnvelope, context: WorkerContext): BridgeEnvelope | undefined {
  // context.roster is the real match roster, frozen once at lobby.startGame
  // -- only used the *first* time this gameId's session is created (the
  // factory below is ignored on every later call for the same gameId, same
  // as passing no factory at all).
  const session = sessions.get(envelope.gameId, () => ({
    turns: new TurnOrder(context.roster ?? DEFAULT_PLAYERS),
    table: [],
  }));

  // user.getProfile and pre-game lobby (membership/ready/host/kick/start)
  // are both handled by play-api now -- see jc.user/jc.lobby in the
  // SDK. By the time this rules bundle sees submitIntent, the match has
  // already started.

  // apps/host's client-side loading screen only clears on a
  // multiplayer/roomEvent broadcast carrying {type: "engineReady"} --
  // nothing in the platform sends that automatically. Without this, a
  // client calling jc.multiplayer.signalEngineReady() (once its own
  // bundle has mounted -- see client_ui_example.tsx.tmpl) gets stuck on
  // the loading screen forever, even though everything else works.
  if (envelope.domain === "multiplayer" && envelope.action === "engineReady") {
    const req = envelope.payload as { playerId: string };
    return reply(envelope, "multiplayer", "roomEvent", { type: "engineReady", playerId: req.playerId });
  }

  if (envelope.domain === "multiplayer" && envelope.action === "submitIntent") {
    const intent = envelope.payload as multiplayer.PlayerIntent;

    if (!session.turns.isCurrentTurn(intent.playerId)) {
      // Reject out-of-turn moves -- this is the one rule Card/Board always
      // enforces server-side; everything else is your ruleset to add.
      return reply(envelope, "multiplayer", "stateView", stateViews(session, context));
    }

    if (intent.intent === "playCard") {
      session.table.push(intent.data);
      session.turns.advance();
    }

    return reply(envelope, "multiplayer", "stateView", stateViews(session, context));
  }

  return undefined;
}

function stateViews(session: TableSession, context: WorkerContext): multiplayer.StateView[] {
  return stateViewsForPlayers(context.roster ?? DEFAULT_PLAYERS, {
    revision: session.turns.revision,
    publicState: {
      turnOrder: session.turns.players(),
      currentTurn: session.turns.current(),
      table: session.table,
    },
    privateState: {},
  });
}
